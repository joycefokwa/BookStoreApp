
@model BookStoreApp.Models.Book

@{
    ViewBag.Title = "Details";
}

<h2>Book Details</h2>

<div>
    <h4>Book</h4>
    <hr />

    <p>
        <strong>Book Id: </strong>
        @Model.BookId
    </p>

    <p>
        <strong>Book Title: </strong>
        @Model.Title
    </p>

    <p>
        <strong>Price: </strong>
        @Model.Price
    </p>

    <p>
        <strong>Stock: </strong>
        @Model.Stock
    </p>

    <p>
        <strong>Author Id: </strong>
        @Model.AuthorId
    </p>
</div>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.BookId }) |
    @Html.ActionLink("Back to List", "Index")
</p>
