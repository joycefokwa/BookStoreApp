@model IEnumerable<BookStoreApp.Models.Author>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th></th>
    </tr>

@foreach (var author in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => author.Name)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id= author.AuthorId }) |
            @Html.ActionLink("Details", "Details", new { id= author.AuthorId }) |
            @Html.ActionLink("Delete", "Delete", new { id= author.AuthorId })
        </td>
    </tr>
}

</table>
